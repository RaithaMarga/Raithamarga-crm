# RaithaMarga CRM & Backend Environment Variables
PORT=5000

# Firebase Client / Web Config (if running frontend dashboard)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (optional service account JSON or environment keys)
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=your_client_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Required backend authentication: absolute path to an external service-account key.
# Keep this key outside the repository and never use VITE_ for admin secrets.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/firebase-service-account.json
# Alternatively omit FIREBASE_SERVICE_ACCOUNT_PATH to use Application Default Credentials.

# --- Vercel / serverless deployment ---
# File paths don't work on Vercel. Provide the service account via env vars instead:
# Option A (easiest): paste the whole service-account JSON (or its base64) here
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual values (keep the \n escapes in the private key)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Also set a strong secret for login tokens:
# JWT_SECRET=change_me
